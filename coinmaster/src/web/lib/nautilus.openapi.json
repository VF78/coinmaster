{
  "components": {
    "schemas": {
      "ConfigurationInput": {
        "properties": {
          "config": {
            "additionalProperties": true,
            "description": "Exact candidate configuration; monetary values are decimal strings.",
            "title": "Config",
            "type": "object"
          }
        },
        "required": [
          "config"
        ],
        "title": "ConfigurationInput",
        "type": "object"
      },
      "ConfigurationRecord": {
        "properties": {
          "config": {
            "additionalProperties": true,
            "title": "Config",
            "type": "object"
          },
          "config_hash": {
            "title": "Config Hash",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "config_hash",
          "created_at",
          "config"
        ],
        "title": "ConfigurationRecord",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PreflightInput": {
        "properties": {
          "active_usdt": {
            "default": "10000",
            "title": "Active Usdt",
            "type": "string"
          },
          "btc_notional": {
            "default": "90000",
            "title": "Btc Notional",
            "type": "string"
          },
          "sol_notional": {
            "default": "0",
            "title": "Sol Notional",
            "type": "string"
          },
          "venue": {
            "enum": [
              "bybit",
              "hyperliquid"
            ],
            "title": "Venue",
            "type": "string"
          }
        },
        "required": [
          "venue"
        ],
        "title": "PreflightInput",
        "type": "object"
      },
      "RunInput": {
        "properties": {
          "config_id": {
            "title": "Config Id",
            "type": "string"
          },
          "kind": {
            "enum": [
              "fixture",
              "backtest",
              "paper"
            ],
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "config_id",
          "kind"
        ],
        "title": "RunInput",
        "type": "object"
      },
      "RunRecord": {
        "properties": {
          "config_id": {
            "title": "Config Id",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "title": "Evidence",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "report": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Report"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "config_id",
          "kind",
          "status",
          "evidence",
          "created_at"
        ],
        "title": "RunRecord",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Coinmaster Nautilus Control API",
