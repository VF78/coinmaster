{
  "name": "coinmaster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web",
    "build:web": "vite build",
    "start": "tsx src/server/index.ts",
    "tunnel": "./scripts/tunnel-localhost-run.sh",
    "tunnel:fixed": "./scripts/tunnel-localhost-run.sh coinmaster-vf",
    "seed": "tsx scripts/seed.ts",
    "persistence:seed-pg": "tsx scripts/persistence-seed-postgres.ts",
    "persistence:reconcile": "tsx scripts/persistence-reconcile.ts",
    "persistence:cutover-check": "bash scripts/persistence-cutover-check.sh",
    "persistence:rollback-check": "bash scripts/persistence-rollback-check.sh",
    "check": "tsc --noEmit",
    "ops:smoke": "bash ./scripts/preflight-smoke.sh",
    "invariants:trading-rules": "tsx scripts/invariants-trading-rules.ts",
    "invariants:allocation-sizing": "tsx scripts/invariants-allocation-sizing.ts",
    "invariants:engulfing": "tsx scripts/invariants-engulfing.ts",
    "invariants:fvg": "tsx scripts/invariants-fvg.ts",
    "invariants:rule-engine": "tsx scripts/invariants-rule-engine.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "hyperliquid": "^1.7.7",
    "lightweight-charts": "^4.2.3",
    "lowdb": "^7.0.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
