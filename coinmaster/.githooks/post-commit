#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
branch="$(git -C "$repo_root" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"

# Auto-deploy only from main to avoid accidental pushes from scratch branches.
if [[ "$branch" != "main" ]]; then
  exit 0
fi

log_file="${repo_root}/.ops/auto-deploy.log"
mkdir -p "$(dirname "$log_file")"

{
  printf '\n[%s] post-commit auto-deploy start\n' "$(date -Is)"
  "$repo_root/scripts/deploy-prod-safe.sh"
  printf '[%s] post-commit auto-deploy success\n' "$(date -Is)"
} >>"$log_file" 2>&1
