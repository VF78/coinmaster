{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 3,
  "stake_currency": "USDC",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": true,
  "trading_mode": "futures",
  "margin_mode": "cross",
  "liquidation_buffer": 0.05,
  "timeframe": "5m",
  "strategy": "CoinMasterStrategy",
  "force_entry_enable": false,
  "unfilledtimeout": {
    "entry": 30,
    "exit": 30,
    "unit": "seconds",
    "exit_timeout_count": 0
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "emergency_exit": "market",
    "force_entry": "limit",
    "force_exit": "market",
    "stoploss": "limit",
    "stoploss_on_exchange": false
  },
  "exchange": {
    "name": "hyperliquid",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "rateLimit": 150,
      "options": {
        "defaultType": "swap"
      }
    },
    "pair_whitelist": [
      "BTC/USDC:USDC",
      "ETH/USDC:USDC",
      "SOL/USDC:USDC"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "replace-with-private-random-secret",
    "ws_token": "replace-with-private-random-ws-token",
    "CORS_origins": [],
    "username": "coinmaster",
    "password": "replace-with-private-password"
  },
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": "",
    "allow_custom_messages": true,
    "notification_settings": {
      "entry": "silent",
      "entry_fill": "on",
      "entry_cancel": "silent",
      "exit": "silent",
      "exit_fill": "on",
      "warning": "on",
      "status": "off",
      "startup": "off"
    }
  },
  "bot_name": "coinmaster-freqtrade",
  "initial_state": "stopped",
  "internals": {
    "process_throttle_secs": 5
  }
}
