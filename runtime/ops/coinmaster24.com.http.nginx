# Enable first for exact-Host ACME testing. No GUI upstream is exposed here.
server {
    listen 80;
    listen [::]:80;
    server_name coinmaster24.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }
    location / { return 308 https://coinmaster24.com$request_uri; }
}
