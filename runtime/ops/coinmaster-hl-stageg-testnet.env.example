# D3 public-MAINNET-data/native-sandbox process. No wallet or signing key.
# Optional read-only Info observer: set this PUBLIC master/subaccount address only
# in the root-owned /etc/coinmaster-hl-stageg-testnet.env when separately installed.
# Never use an agent/API wallet as the account reference.
# COINMASTER_HL_READONLY_ACCOUNT_REF=0x<40-hex-account-address>
COINMASTER_LIVE_ENABLED=false
COINMASTER_HL_TESTNET_ENABLED=true
COINMASTER_HL_TESTNET_ENVIRONMENT=mainnet
COINMASTER_HL_TESTNET_INSTANCE_CONFIG=/srv/coinmaster/runtime/configs/hl-stageg-testnet.instance.json
# Read-only status listener binds IPv4 loopback only. No command routes exist.
COINMASTER_HL_STAGEG_STATUS_PORT=18183
