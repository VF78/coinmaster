# D3's public-MAINNET-data/native-sandbox process. No wallet or account env.
COINMASTER_LIVE_ENABLED=false
COINMASTER_HL_TESTNET_ENABLED=true
COINMASTER_HL_TESTNET_ENVIRONMENT=mainnet
COINMASTER_HL_TESTNET_INSTANCE_CONFIG=/etc/coinmaster/hl-stageg-testnet.instance.json
# Root provisions this as a narrowly readable status handoff for the runtime
# sidecar. It is a one-way projection, never a command or database path.
COINMASTER_HL_STAGEG_PROJECTION_PATH=/run/coinmaster/hl-stageg-testnet-projection.json
