# D3's distinct TESTNET process. Do not combine this with paper/mainnet env.
COINMASTER_LIVE_ENABLED=false
COINMASTER_HL_TESTNET_ENABLED=true
COINMASTER_HL_TESTNET_ENVIRONMENT=testnet
COINMASTER_HL_TESTNET_INSTANCE_CONFIG=/etc/coinmaster/hl-stageg-testnet.instance.json
# This is the actual master or sub-account queried by authenticated endpoints,
# never the API/agent wallet address. It is an address, not a secret.
COINMASTER_HL_TESTNET_MASTER_ACCOUNT_ADDRESS=0x0000000000000000000000000000000000000000
# Runtime secret only. Do not put its value in this file, logs, configs, docs,
# tests, or shell history. Nautilus resolves this env variable internally.
HYPERLIQUID_TESTNET_PK=
