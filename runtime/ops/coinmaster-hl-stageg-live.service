[Unit]
Description=CoinMaster isolated Hyperliquid live pilot (explicit order approval required)
After=network-online.target
ConditionPathExists=/etc/coinmaster/live-order-approval.json

[Service]
Type=simple
User=coinmaster-hl-live
Group=coinmaster-hl-live
WorkingDirectory=/srv/coinmaster/hl-live/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=COINMASTER_HL_LIVE_INSTANCE_CONFIG=/srv/coinmaster/hl-live/current/configs/hl-stageg-live.instance.json
Environment=COINMASTER_HL_STAGEG_STATUS_PORT=18184
Environment=COINMASTER_LIVE_ORDER_APPROVAL=/etc/coinmaster/live-order-approval.json
EnvironmentFile=/etc/coinmaster-hl-live-control.env
LoadCredential=connection.json:/var/lib/coinmaster-connections/cccab09df4d1385ae1f893ecfaf91dcf.json
ExecStartPre=/srv/coinmaster/hl-live/current/.venv/bin/python -m coinmaster.ops.stage_g_refresh --data-root /var/lib/coinmaster-hl-stageg-live/data
ExecStartPre=/srv/coinmaster/hl-live/current/.venv/bin/python -m coinmaster.ops.hl_live_credential_preflight --fingerprints /srv/coinmaster/hl-live/current/configs/hl-stageg-live.account-fingerprint.json
ExecStart=/srv/coinmaster/hl-live/current/.venv/bin/python -m coinmaster.ops.hl_live_worker
Restart=no
UMask=0077
StateDirectory=coinmaster-hl-stageg-live
StateDirectoryMode=0700
RuntimeDirectory=coinmaster-hl-live
RuntimeDirectoryMode=0700
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/coinmaster/hl-live
ReadWritePaths=/var/lib/coinmaster-hl-stageg-live /run/coinmaster-hl-live

[Install]
WantedBy=multi-user.target
