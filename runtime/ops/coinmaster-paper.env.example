COINMASTER_LIVE_ENABLED=false
COINMASTER_PAPER_HOST=127.0.0.1
COINMASTER_PAPER_PORT=18181
COINMASTER_PAPER_OWNER=coinmaster-paper
COINMASTER_PAPER_DB=/var/lib/coinmaster-paper/paper.sqlite
# Distinct loopback operator/API and worker relay tokens; never commit values.
COINMASTER_RUNTIME_API_TOKEN=replace-with-local-operator-token
COINMASTER_PAPER_CONTROL_TOKEN=replace-with-worker-relay-token
