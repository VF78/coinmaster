[Unit]
Description=CoinMaster isolated Hyperliquid Stage-G TESTNET trader node
After=network-online.target

[Service]
Type=simple
ExecStartPre=/srv/coinmaster/runtime/.venv/bin/python -m coinmaster.ops.stage_g_refresh --data-root /var/lib/coinmaster-hl-stageg-testnet/data
TimeoutStartSec=180
RestartSec=300
EnvironmentFile=/etc/coinmaster-hl-stageg-testnet.env
User=coinmaster-hl
Group=coinmaster-hl
WorkingDirectory=/srv/coinmaster/runtime
ExecStart=/srv/coinmaster/runtime/.venv/bin/python -m coinmaster.ops.hyperliquid_testnet_worker
Restart=on-failure
NoNewPrivileges=true
UMask=0077
StateDirectory=coinmaster-hl-stageg-testnet
StateDirectoryMode=0700
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/coinmaster/runtime /etc/coinmaster
ReadWritePaths=/var/lib/coinmaster-hl-stageg-testnet
Environment=PYTHONDONTWRITEBYTECODE=1
# This service deliberately has no Requires=/After= relationship to the API
# sidecar or research children. Each may be stopped/restarted independently.

[Install]
WantedBy=multi-user.target
