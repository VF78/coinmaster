# Enable only after the coinmaster24.com certificate and login gates pass.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name coinmaster24.com;
    ssl_certificate /etc/letsencrypt/live/coinmaster24.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/coinmaster24.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    if ($host != coinmaster24.com) { return 421; }
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:18182;
        proxy_http_version 1.1;
        proxy_set_header Host coinmaster24.com;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Authorization "";
        proxy_set_header X-Coinmaster-Public-Proxy "1";
        proxy_set_header Connection "";
    }
}
