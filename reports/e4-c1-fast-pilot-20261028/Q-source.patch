+def test_interval_boundary_event_dd_excludes_terminal_fill_keeps_prequote(tmp_path):
+ observer=CommittedNativeObserver(tmp_path/'boundary.gz',D(100),(BTC_PERP,SOL_PERP),end_exclusive_ns=100)
+ try:
+  def state(cash):return dict(cash=D(cash),positions=(),position_hash='flat',signature=(cash,'flat'))
+  observer._emit('PREQUOTE_DIRECT_NATIVE',100,state('120'))
+  observer._emit('POST_FILL_COMMITTED_NATIVE',100,state('1'))
+  observer._emit('PREQUOTE_DIRECT_NATIVE',100,state('1'))
+  observer._emit('DIRECT_NATIVE_AFTER_ENGINE_END_RETURNED',100,state('1'))
+  report=observer.report()
+  assert report['event_drawdown']['samples']==2
+  assert report['event_drawdown']['minimum']['equity']=='100'
+  assert report['event_drawdown']['top3_distinct_excursions']==[]
+ finally:observer.close()
