+
+
+def config(**kw):
+    return lifecycle_config(research_h4_ema=34,
+        research_h4_seed=tuple((i*H4_NS,90. if i == 0 else 100.) for i in range(-729,1)),
+        max_mark_age_ns=10*H4_NS, **kw)
