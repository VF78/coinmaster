    def test_unknown_ack_stays_pending_until_proven_zero_or_partial_terminal() -> None:
        strategy = WaveOverlayStrategy(probe_config())
        entry = Intent("unknown-entry", "episode", "BTC_ENTRY", None, 1, requested_notional=100)
