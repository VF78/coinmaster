+    @staticmethod
+    def _corridor_interval(loss,points,C):
+        # Convex piecewise-linear sublevel set. Points include all loss kinks.
+        points=sorted(set(points));best=min(points,key=lambda q:(loss(q),q))
+        legal=[]
